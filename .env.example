# Backend and local infrastructure settings. Copy to .env for local overrides; .env is
# git-ignored. Never commit real credentials. Frontend settings live in frontend/.env.example.
# Spring Boot does not read .env itself: export these variables in your shell or IDE run
# configuration. Docker Compose reads .env automatically for the POSTGRES_* values.

# --- Local PostgreSQL (compose.yaml) ---
POSTGRES_DB=strategy
POSTGRES_USER=strategy
POSTGRES_PASSWORD=strategy
POSTGRES_PORT=5432

# --- Backend ---
# Profile: local (default when unset) or prod.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
# Required in prod (no defaults). In local they default to the compose values above.
DB_URL=jdbc:postgresql://localhost:5432/strategy
DB_USERNAME=strategy
DB_PASSWORD=strategy
DB_POOL_SIZE=10

# --- Supabase Auth (access-token verification) ---
# Project URL. Issuer (<url>/auth/v1) and JWKS (<url>/auth/v1/.well-known/jwks.json) are derived
# from it. Required in prod; local default is the Supabase CLI stack http://127.0.0.1:54321.
# Only public information is needed: the backend holds NO Supabase secret or service-role key.
SUPABASE_URL=https://your-project-ref.supabase.co
# Optional overrides (defaults shown).
SUPABASE_JWT_AUDIENCE=authenticated
# Asymmetric signing keys only (Supabase "JWT Signing Keys"). HS256 is deliberately unsupported.
SUPABASE_JWT_ALGORITHMS=ES256,RS256

# --- CORS ---
# Comma-separated browser origins allowed to call the API. Local default: the Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

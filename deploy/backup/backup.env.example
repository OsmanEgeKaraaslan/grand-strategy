# Backup configuration on the VPS (docs/PRODUCTION_READINESS.md §8). Copy to /etc/strategy/backup.env,
# chmod 600, owner root. Never commit the filled-in file.

# Read-only role from deploy/supabase/app-role.sql. Supabase's direct host is IPv6-only unless the
# IPv4 add-on is enabled; the units use the host network, so this works on a VPS with IPv6. Otherwise
# use the session pooler: postgresql://strategy_backup.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
BACKUP_DATABASE_URL=postgresql://strategy_backup:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Also back up Supabase's accounts (schema "auth") into the same encrypted file. Needs step 3 of
# deploy/supabase/app-role.sql; if that grant is refused, set false and rely on Supabase's backups.
BACKUP_INCLUDE_AUTH=true

# Offsite storage: Backblaze B2 bucket in the EU region, application key restricted to that bucket
# WITHOUT deleteFiles (listBuckets, listFiles, writeFiles; readFiles is harmless, the files are encrypted).
RCLONE_CONFIG_OFFSITE_TYPE=b2
RCLONE_CONFIG_OFFSITE_ACCOUNT=<application key id>
RCLONE_CONFIG_OFFSITE_KEY=<application key>
BACKUP_REMOTE=offsite:<bucket-name>/game

# Local copies are removed after this many days once confirmed offsite. Keep equal to the bucket's
# lifecycle rule and the Privacy Policy (§5: 30 days).
BACKUP_RETENTION_DAYS=30
BACKUP_MAX_AGE_HOURS=26

# Optional heartbeat check (e.g. healthchecks.io): period 1 hour, grace 1 hour.
BACKUP_HEARTBEAT_URL=

# Production environment for the API container (compose.prod.yaml). Copy to .env.production on the
# VPS, fill in, `chmod 600` it, and never commit it. Values marked REQUIRED have no default.
# See docs/PRODUCTION_READINESS.md §4 for every variable.

# --- Database (Supabase PostgreSQL; direct or session-mode connection, NOT the transaction pooler) ---
# REQUIRED. The application role needs DML on schema "game" only.
DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=strategy_app
DB_PASSWORD=
DB_POOL_SIZE=10
DB_CONNECTION_TIMEOUT_MS=10000
# Optional: a separate role for Flyway migrations (DDL). Defaults to DB_USERNAME/DB_PASSWORD.
FLYWAY_USER=
FLYWAY_PASSWORD=

# --- Supabase Auth (token verification needs only public values; no service-role key here) ---
# REQUIRED.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256

# --- Web ---
# REQUIRED: the deployed frontend origin(s), comma-separated, exact scheme and host.
CORS_ALLOWED_ORIGINS=https://<frontend-domain>
SERVER_PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=native
SERVER_MAX_THREADS=100
SERVER_MAX_CONNECTIONS=2000

# --- Abuse protection (docs/SECURITY_AUDIT.md §4) ---
RATE_LIMITS_ENABLED=true
GAME_MAX_UNFINISHED_PER_PLAYER=10
GAME_MAX_UNFINISHED_TOTAL=200

# --- Moderation (docs/PRODUCTION_READINESS.md §4) ---
# Supabase user ids (Supabase -> Authentication -> Users -> UID) allowed to use /admin, comma-separated.
ADMIN_SUPABASE_USER_IDS=

# --- Computer opponents ---
STRATEGY_AI_EXECUTION=async
STRATEGY_AI_WORKER_THREADS=2

# --- Legal document versions (must match frontend/src/legal/documents.ts SIGN_UP_VERSIONS) ---
LEGAL_TERMS_VERSION=1.0
LEGAL_PRIVACY_VERSION=1.0
LEGAL_REQUIRE_ACCEPTANCE=true

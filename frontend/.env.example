# Copy to .env.local (git-ignored). Only PUBLIC values may appear here: everything prefixed
# VITE_ is compiled into the browser bundle.

# Spring Boot API origin (no trailing slash, without /api/v1).
VITE_API_BASE_URL=http://localhost:8080

# Supabase project URL. Local Supabase CLI default: http://127.0.0.1:54321
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Supabase *publishable* key (or the legacy "anon" key). It is designed to be public.
# NEVER put the secret / service_role key here or anywhere in the frontend.
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# Cloudflare Turnstile site key (public). Set it together with CAPTCHA protection in Supabase
# (Authentication -> Attack Protection); leave empty for local development without CAPTCHA.
# Cloudflare's always-passing test key: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
